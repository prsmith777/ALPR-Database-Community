# `./alpr-community install` creates the private .env, asks for the application
# administrator password, and generates the database password automatically.
# Manual deployments must replace both blank values; Compose refuses blanks.
ADMIN_PASSWORD=
DB_PASSWORD=

# Change to true only when the application is served through HTTPS.
SESSION_COOKIE_SECURE=false

# Use an IANA time-zone name, for example America/New_York. UTC is the safe
# default when no installation-specific zone has been selected.
TZ=UTC
APP_PORT=3000
DB_PORT=5432

# Bounded, structured operational logging. The app log contains redacted
# metadata only; Compose persists it in the app-logs volume. Ingress receipts
# store request shape and outcome metadata, never plate or image contents.
ALPR_LOG_LEVEL=info
ALPR_OPERATIONAL_LOG_FILE_MAX_BYTES=5242880
ALPR_OPERATIONAL_LOG_MAX_FILES=20
ALPR_INTEGRATION_MAX_BODY_BYTES=33554432
ALPR_INGRESS_RECEIPT_RETENTION_DAYS=14
ALPR_INGRESS_RECEIPT_MAX_ROWS=25000
ALPR_AUDIT_HOT_RETENTION_DAYS=90
# Bound the Docker json-file logs emitted by PostgreSQL itself.
ALPR_POSTGRES_LOG_MAX_SIZE=10m
ALPR_POSTGRES_LOG_MAX_FILES=5

# Only used with docker-compose.without-database.yml:
# DB_HOST=database-host.example:5432
# DB_NAME=postgres
# DB_USER=postgres

# Optional first-run defaults for background visual-search indexing.
VISUAL_INDEX_ENABLED=true
VISUAL_INDEX_PAUSED=false
VISUAL_INDEX_BATCH_SIZE=20
VISUAL_INDEX_INTERVAL_SECONDS=30
VISUAL_INDEX_MINIMUM_FREE_DISK_GB=5
VISUAL_INDEX_MAXIMUM_LOAD_PERCENT=90

# Optional notification-channel defaults. Secrets are stored privately and are
# never returned by the Settings API.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_VERIFY_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=ALPR Database
WEBHOOK_ENABLED=false
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Optional Blue Iris alert-correlation API. The account only needs permission
# to view cameras, alerts, and clips. Prefer a dedicated read-only BI user.
BLUEIRIS_HOST=
BLUEIRIS_USERNAME=
BLUEIRIS_PASSWORD=
BLUEIRIS_TIMEOUT_SECONDS=10
BLUEIRIS_TIMELINE_EXPORT_PROFILE=0
BLUEIRIS_TIMELINE_EXPORT_MIN_WIDTH=1920
BLUEIRIS_TIMELINE_EXPORT_MIN_HEIGHT=1080
